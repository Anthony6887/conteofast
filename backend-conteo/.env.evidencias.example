# Añadir a tu .env existente, sin reemplazar las credenciales ni otras variables.
# Docker (montar el directorio persistente del host en /data/evidencias):
CF_EVIDENCIAS_DIR=/data/evidencias
# Si se ejecuta Node directamente como administrador, usar en su lugar:
# CF_EVIDENCIAS_DIR=/home/administrador/apps/evidencias-conteofast
